# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=TeteriaEncantada
DB_USERNAME=postgres
DB_PASSWORD=

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- App ---
FRONTEND_URL=http://localhost:5173
PORT=3000

# Base pública del backend, la usa Mercado Pago para llamar al webhook.
PUBLIC_API_URL=http://api.teteria.187.127.53.63.nip.io/api

# Destinatarios de alertas de pago (separados por coma). Si queda vacía, las
# alertas sólo quedan en el log del backend.
PAYMENT_ALERTS_EMAIL=

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=reserva_recordatorio

# --- Almacenamiento en disco ---
# Imágenes públicas en /api/uploads/images; ventas/ es privada.
UPLOADS_DIR=/app/uploads

# Google OAuth2 (Fase 3)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_CALLBACK_URL=https://tu-dominio/api/auth/google/callback
