# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=TeteriaEncantada
DB_USERNAME=postgres
DB_PASSWORD=

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- App ---
FRONTEND_URL=http://localhost:5173
PORT=3000

# Base pública del backend, la usa Mercado Pago para llamar al webhook.
# Debe ser alcanzable desde internet e incluir el prefijo global /api que
# aplica main.ts. Prod: https://dencanto.duckdns.org/api
PUBLIC_API_URL=http://localhost:3000/api

# --- Rate limiting (ttl en ms) ---
# Global. Prod: 100 / 60s
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# POST /auth/login. Prod: 5 / 15min
AUTH_THROTTLE_TTL=900000
AUTH_THROTTLE_LIMIT=5

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=reserva_recordatorio

# --- AWS S3 ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=teteria-encantada-dev
# Opcional: sobrescribe la base de la URL pública (CloudFront / endpoint custom).
# Si se omite, se usa https://<bucket>.s3.<region>.amazonaws.com
AWS_S3_PUBLIC_URL_BASE=
